# Copy to .env and adjust as needed.

APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=mysql+pymysql://yinggen:yinggen@127.0.0.1:3307/yinggen?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yinggen
MINIO_SECURE=false

JWT_SECRET=dev-secret-change-me

# ASR provider: mock | volcengine | tencent
ASR_PROVIDER=mock

# Volcengine (ByteDance / Doubao) ASR
ASR_VOLCENGINE_API_KEY=
ASR_VOLCENGINE_APP_ID=
ASR_VOLCENGINE_RESOURCE_ID=volc.seedasr.auc
ASR_VOLCENGINE_BASE_URL=https://openspeech.bytedance.com

# Tencent Cloud ASR
ASR_TENCENT_SECRET_ID=
ASR_TENCENT_SECRET_KEY=
ASR_TENCENT_REGION=ap-guangzhou

# Aliyun ASR (reserved)
ASR_ALIYUN_ACCESS_KEY_ID=
ASR_ALIYUN_ACCESS_KEY_SECRET=
ASR_ALIYUN_REGION=cn-shanghai

# iFlytek ASR (reserved)
ASR_IFLYTEK_APP_ID=
ASR_IFLYTEK_API_KEY=
ASR_IFLYTEK_API_SECRET=

MAX_VIDEO_SECONDS=1800
MAX_UPLOAD_MB=300
TRANSCODE_VIDEO=true
VIDEO_RETENTION_DAYS=30
WORK_DIR=/tmp/yinggen

# Douyin link resolver (Node + Playwright + Chromium)
NODE_BIN=node
DOUYIN_RESOLVER_ENABLED=true
DOUYIN_RESOLVER_TIMEOUT=180
