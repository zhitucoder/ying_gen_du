# Copy to .env and adjust as needed.

APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=mysql+pymysql://yinggen:yinggen@127.0.0.1:3307/yinggen?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yinggen
MINIO_SECURE=false

JWT_SECRET=dev-secret-change-me

# ASR provider: mock | volcengine | tencent
ASR_PROVIDER=mock

# Volcengine (ByteDance / Doubao) ASR
ASR_VOLCENGINE_API_KEY=
ASR_VOLCENGINE_APP_ID=
ASR_VOLCENGINE_RESOURCE_ID=volc.seedasr.auc
ASR_VOLCENGINE_BASE_URL=https://openspeech.bytedance.com

# Tencent Cloud ASR
ASR_TENCENT_SECRET_ID=
ASR_TENCENT_SECRET_KEY=
ASR_TENCENT_REGION=ap-guangzhou

# Aliyun ASR (reserved)
ASR_ALIYUN_ACCESS_KEY_ID=
ASR_ALIYUN_ACCESS_KEY_SECRET=
ASR_ALIYUN_REGION=cn-shanghai

# iFlytek ASR (reserved)
ASR_IFLYTEK_APP_ID=
ASR_IFLYTEK_API_KEY=
ASR_IFLYTEK_API_SECRET=

# SMS (Tencent Cloud)
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_SIGN_NAME=
SMS_TENCENT_TEMPLATE_ID=
SMS_TENCENT_REGION=ap-guangzhou
SMS_CODE_LENGTH=6
SMS_CODE_TTL_SECONDS=300
SMS_CODE_SECRET=dev-sms-secret-change-me
SMS_MOCK_CODE=123456
SMS_COOLDOWN_SECONDS=60
SMS_HOURLY_LIMIT=3
SMS_DAILY_LIMIT=5
SMS_IP_HOURLY_LIMIT=10
SMS_IP_DAILY_LIMIT=30
SMS_DEVICE_DAILY_LIMIT=5
SMS_MAX_VERIFY_ATTEMPTS=5

NICKNAME_DEFAULT_PREFIX=学神
NICKNAME_ALLOWED_PREFIXES=学神,学霸
NICKNAME_SEQUENCE_WIDTH=2
MEDIA_DEDUP_ENABLED=true
MEDIA_GC_GRACE_SECONDS=86400
MEDIA_STAGING_PREFIX=staging/
MEDIA_ASSET_PREFIX=media/
RECORDING_MAX_SECONDS=15

MAX_VIDEO_SECONDS=1800
MAX_UPLOAD_MB=300
TRANSCODE_VIDEO=true
VIDEO_RETENTION_DAYS=30
WORK_DIR=/tmp/yinggen

# Douyin link resolver (Node + Playwright + Chromium)
NODE_BIN=node
DOUYIN_RESOLVER_ENABLED=true
DOUYIN_RESOLVER_TIMEOUT=180
